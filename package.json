{
  "name": "@with-logic/magic-image",
  "version": "0.0.1",
  "author": "Logic Inc.",
  "description": "A React component for AI-powered image generation with an in-browser dev overlay",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./replicate": {
      "import": {
        "types": "./dist/replicate.d.ts",
        "default": "./dist/replicate.js"
      },
      "require": {
        "types": "./dist/replicate.d.cts",
        "default": "./dist/replicate.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook-actions": "node --test scripts/storybook-actions.test.mjs",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "npm run format && npm run lint:fix && npm run typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "replicate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/addon-interactions": "8.6.19",
    "@storybook/addon-links": "8.6.19",
    "@storybook/blocks": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "happy-dom": "21.0.4",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.19",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "keywords": [
    "react",
    "image",
    "ai",
    "generation",
    "llm",
    "replicate",
    "flux",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/with-logic/magic-image"
  },
  "bugs": {
    "url": "https://github.com/with-logic/magic-image/issues"
  },
  "homepage": "https://github.com/with-logic/magic-image#readme",
  "overrides": {
    "@storybook/addon-actions": {
      "uuid": "11.1.1"
    }
  }
}
